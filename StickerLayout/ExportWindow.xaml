<Window x:Class="StickerLayout.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ExportTitle}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Ink0}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">
    <!-- Satu tombol export (daftar tugas leader 2026-11-08): format, isi file, lembar, dan tanda registrasi dipilih dulu, baru file disimpan. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Ink1}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Cancel}" IsCancel="True" MinWidth="88"/>
                <Button x:Name="OkBtn" Style="{StaticResource Primary}" Content="{DynamicResource ExportGo}" IsDefault="True" MinWidth="88" Margin="8,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="16,14,16,16">
            <TextBlock Text="{DynamicResource ExportFormat}" Style="{StaticResource Label}"/>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="1" Margin="0,6,0,14" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FmtPdf" GroupName="Fmt" Style="{StaticResource Choice}" Content="PDF" IsChecked="True" Checked="Changed" ToolTip="{DynamicResource ExportPdfTip}"/>
                    <RadioButton x:Name="FmtSvg" GroupName="Fmt" Style="{StaticResource Choice}" Content="SVG" Checked="Changed" ToolTip="{DynamicResource ExportSvgTip}"/>
                    <RadioButton x:Name="FmtJpg" GroupName="Fmt" Style="{StaticResource Choice}" Content="{DynamicResource ExportJpg}" Checked="Changed" ToolTip="{DynamicResource ExportJpgTip}"/>
                    <RadioButton x:Name="FmtTicket" GroupName="Fmt" Style="{StaticResource Choice}" Content="{DynamicResource ExportTicket}" Checked="Changed" ToolTip="{DynamicResource ExportTicketTip}"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ContentPart">
                <TextBlock Text="{DynamicResource ExportContent}" Style="{StaticResource Label}"/>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="1" Margin="0,6,0,14" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Both" GroupName="Isi" Style="{StaticResource Choice}" Content="{DynamicResource ExportBoth}" IsChecked="True" ToolTip="{DynamicResource ExportBothTip}"/>
                        <RadioButton x:Name="PrintOnly" GroupName="Isi" Style="{StaticResource Choice}" Content="{DynamicResource ExportPrint}" ToolTip="{DynamicResource ExportPrintTip}"/>
                        <RadioButton x:Name="CutOnly" GroupName="Isi" Style="{StaticResource Choice}" Content="{DynamicResource ExportCut}" ToolTip="{DynamicResource ExportCutTip}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SheetPart">
                <TextBlock Text="{DynamicResource ExportPages}" Style="{StaticResource Label}"/>
                <CheckBox x:Name="AllPages" Content="{DynamicResource ExportAll}" IsChecked="True" Margin="0,6,0,0" Click="All_Click"/>
                <WrapPanel x:Name="PageList" Margin="18,4,0,14"/>
                <CheckBox x:Name="Marks" Content="{DynamicResource ExportMarks}" ToolTip="{DynamicResource ExportMarksTip}"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
